{
  "name": "zvect",
  "version": "0.1.0",
  "description": "Learn vectors step by step: vector, distance, dot product, cosine, embedding matrix, latent space, vector search, bi-encoder, reranker, classification. 3D canvas lessons + a tiny zero-dependency vector lib (JS / Python / C++).",
