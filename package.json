    "check": "node tools/check-examples.js",
    "manifest": "node tools/make-manifest.js",
    "reindex": "node tools/reindex.js",
    "zv": "node tools/zv.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
